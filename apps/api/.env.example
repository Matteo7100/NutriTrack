# Database solo locale dimostrativo. Copiare in .env e cambiare le credenziali fuori dalla demo.
DATABASE_URL=postgresql://nutritrack:nutritrack_local@localhost:15432/nutritrack?schema=public
PORT=3000
NODE_ENV=development

# Recupero password via Resend. Il mittente deve appartenere a un dominio verificato.
PUBLIC_APP_URL=http://localhost:3000/
RESEND_API_KEY=
PASSWORD_RESET_FROM=
# Solo in locale: senza Resend, link di recupero e avvisi di invito vengono stampati nel
# terminale del server. Mai attivo con NODE_ENV=production.
MAIL_CONSOLE=true
# Livello dei log JSON: info (predefinito) oppure debug (include gli health check).
LOG_LEVEL=info
