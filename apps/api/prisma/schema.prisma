// Ogni tabella appartiene a un modulo. Il lock e la transazione serializzano i comandi.
generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model Account {
  id             String           @id
  email          String           @unique
  name           String
  role           String
  salt           String
  passwordHash   String
  birthDate      DateTime?        @db.Date
  heightCm       Float?
  resetDigest    String?          @unique
  resetIssuedAt  DateTime?
  resetExpiresAt DateTime?
  sessions       AccountSession[]
}

model AccountSession {
  id        String   @id
  userId    String
  csrfToken String
  expiresAt DateTime
  account   Account  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
model PatientState {
  id String @id
  data Json
}
model MealPlanningState {
  id String @id
  data Json
}
model DiaryState {
  id String @id
  data Json
}
model ProgressState {
  id String @id
  data Json
}
model ProgressPhoto {
  id          String   @id
  patientId   String
  operationId String
  timestamp   DateTime
  createdAt   DateTime
  mimeType    String
  bytes       Bytes

  @@unique([patientId, operationId])
  @@index([patientId, timestamp])
}
